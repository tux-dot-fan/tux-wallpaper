# Tux Wallpaper - Environment Variables
# Copy this file to .env and fill in your values

# Remote server URL
TUX_REMOTE_BASE_URL=http://localhost:18420

# API Keys
TUX_API_KEY=your_api_key_here

# Stripe (for paid wallpapers)
STRIPE_API_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Debug mode
TUX_DEBUG=false
